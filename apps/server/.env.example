PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SYNC_ON_START=false

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

PUBLIC_API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://agentity-monorepo-client.vercel.app

# Active runtime profile. Use testnet day-to-day; switch to mainnet for readiness checks.
HEDERA_NETWORK=testnet
HEDERA_ENABLE_REAL_PROOFS=false
HEDERA_ENABLE_REAL_TRANSFERS=false

# Generic fallback values remain supported for existing deployments.
# Leave these blank when using the TESTNET/MAINNET profile blocks below.
HEDERA_MIRROR_NODE_URL=
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_OPERATOR_KEY_PATH=
HEDERA_CONSENSUS_TOPIC_ID=
HEDERA_DEFAULT_TOKEN_ID=

# Testnet profile. Used when HEDERA_NETWORK=testnet.
HEDERA_TESTNET_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_TESTNET_OPERATOR_ACCOUNT_ID=0.0.8479610
HEDERA_TESTNET_OPERATOR_PRIVATE_KEY=0x887d5d5d75e7cbc5fa3bebecd1800a1999f180ca7d8111b8bf9c523301edce45
HEDERA_TESTNET_OPERATOR_KEY_PATH=
HEDERA_TESTNET_CONSENSUS_TOPIC_ID=
HEDERA_TESTNET_DEFAULT_TOKEN_ID=

# Mainnet profile. Used when HEDERA_NETWORK=mainnet.
HEDERA_MAINNET_MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com
HEDERA_MAINNET_OPERATOR_ACCOUNT_ID=
HEDERA_MAINNET_OPERATOR_PRIVATE_KEY=
HEDERA_MAINNET_OPERATOR_KEY_PATH=
HEDERA_MAINNET_CONSENSUS_TOPIC_ID=
HEDERA_MAINNET_DEFAULT_TOKEN_ID=

HEDERA_PRICE_HBAR_SIMULATION=0.10
HEDERA_PRICE_HBAR_AUDIT=0.20
HEDERA_PRICE_HBAR_EXECUTION=0.50
HEDERA_PRICE_HBAR_COORDINATION=0.15
HEDERA_PRICE_HTS_SIMULATION=1.00
HEDERA_PRICE_HTS_AUDIT=2.50
HEDERA_PRICE_HTS_EXECUTION=5.00
HEDERA_PRICE_HTS_COORDINATION=1.50

AWS_REGION=
